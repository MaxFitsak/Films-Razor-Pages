@page "{id:int?}"
@model FilmMVC.Pages.EditModel
@{
    ViewData["Title"] = "Редагувати фільм";
    
    string imageFolder = "~/Photos/";
    string defaultPoster = "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=700&auto=format&fit=crop&q=80";
    
    string posterPath = !string.IsNullOrEmpty(Model.Film.Photo)
        ? Url.Content($"{imageFolder}{Model.Film.Photo}")
        : defaultPoster;
}

<h2 class="text-secondary mb-4">Редагувати фільм</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <input type="hidden" asp-for="Film.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted">Поточне фото:</label>
                        <div>
                            <img src="@posterPath" 
                                 alt="@Model.Film.FilmName" 
                                 class="img-thumbnail" 
                                 style="max-height: 200px; width: auto; object-fit: cover;" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Film.FilmName" class="form-label fw-bold">Назва фільму</label>
                        <input asp-for="Film.FilmName" class="form-control" placeholder="Введіть назву фільму" />
                        <span asp-validation-for="Film.FilmName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Film.Genre" class="form-label fw-bold">Жанр</label>
                        <input asp-for="Film.Genre" class="form-control" placeholder="Введіть жанр (наприклад, Драма, Комедія)" />
                        <span asp-validation-for="Film.Genre" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Film.Description" class="form-label fw-bold">Опис</label>
                        <textarea asp-for="Film.Description" class="form-control" placeholder="Введіть опис фільму"></textarea>
                        <span asp-validation-for="Film.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Film.Rating" class="form-label fw-bold">Рейтинг</label>
                        <input asp-for="Film.Rating" class="form-control" type="number" step="0.1" min="0" max="10" placeholder="Введіть рейтинг (0.0 - 10.0)" />
                        <span asp-validation-for="Film.Rating" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label for="posterFile" class="form-label fw-bold">Змінити постер фільму</label>
                        <input type="file" 
                               name="photoFile" 
                               id="posterFile" 
                               class="form-control" 
                               accept="image/*"/>
                        <div class="form-text text-muted">Оберіть нове фото постера (.jpg, .png, .webp)</div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-page="/Index" class="btn btn-light border">Повернутися</a>
                        <input type="submit" value="Зберегти зміни" class="btn btn-primary px-4" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}