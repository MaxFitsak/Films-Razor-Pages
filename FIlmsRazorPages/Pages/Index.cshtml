@page
@model IndexModel

@{
ViewData["Title"] = "Топ-10 фільмів";
int rank = 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-white fw-bold mb-1">🎬 Топ-10 фільмів</h2>
        <p class="text-secondary small mb-0">Каталог фільмів з описом, рейтингом та керуванням</p>
    </div>
    <a asp-page="/Create" class="btn btn-warning fw-semibold shadow-sm d-flex align-items-center gap-2">
        <span>+</span> Додати фільм
    </a>
</div>

<div class="d-flex flex-column gap-3">
    @foreach (var item in Model.Films)
    {
    <div class="card bg-dark text-light border-secondary border-opacity-25 shadow rounded-3 overflow-hidden">
        <div class="row g-0">
            <div class="col-12 col-md-3 col-lg-2 position-relative bg-black d-flex align-items-center justify-content-center">
                    <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark fw-bold fs-6 shadow">
                        #@rank
                    </span>
                @{
                string itemPoster = !string.IsNullOrEmpty(item.Photo)
                ? Url.Content($"~/Photos/{item.Photo}")
                : "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop&q=60";
                }
                <img src="@itemPoster"
                     alt="@item.FilmName"
                     class="img-fluid w-100 h-100"
                     style="object-fit: cover; min-height: 190px; max-height: 230px;"
                     loading="lazy"
                     asp-append-version="true" />
            </div>
            
            <div class="col-12 col-md-9 col-lg-10 d-flex flex-column justify-content-between p-3">
                <div>
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h3 class="h5 fw-bold text-white mb-0">
                            @Html.DisplayFor(modelItem => item.FilmName)
                        </h3>
                        <span class="badge bg-warning text-dark fs-6 fw-bold px-2 py-1">
                                @Html.DisplayFor(modelItem => item.Rating)
                            </span>
                    </div>

                    <div class="mb-2">
                            <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary border-opacity-25">
                                @Html.DisplayFor(modelItem => item.Genre)
                            </span>
                    </div>

                    <p class="text-secondary small mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                        @Html.DisplayFor(modelItem => item.Description)
                    </p>
                </div>
                
                <div class="d-flex justify-content-end gap-2 pt-2 border-top border-secondary border-opacity-25">
                    <a asp-page="/Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info px-3">
                        Деталі
                    </a>
                    <a asp-page="/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-3">
                        Редагувати
                    </a>
                    <a asp-page="/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3">
                        Видалити
                    </a>
                </div>
            </div>
        </div>
    </div>
    rank++;
    }
</div>