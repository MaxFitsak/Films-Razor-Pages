@page "{id:int?}"
@model FilmMVC.Pages.DetailsModel

@{
    ViewData["Title"] = "Деталі фільму";
    
    string imageFolder = "~/Photos/";
    string defaultPoster = "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=700&auto=format&fit=crop&q=80";
    
    string posterPath = !string.IsNullOrEmpty(Model.Film.Photo)
        ? Url.Content($"{imageFolder}{Model.Film.Photo}")
        : defaultPoster;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="mb-3">
            <a asp-page="/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 text-light">
                &larr; Повернутися до списку
            </a>
        </div>

        <div class="card bg-dark text-light border-secondary border-opacity-25 shadow-lg rounded-3 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 col-lg-4 bg-black d-flex align-items-center justify-content-center">
                    <img src="@posterPath"
                         alt="@Model.Film.FilmName"
                         class="img-fluid w-100 h-100"
                         style="object-fit: cover; min-height: 380px;"
                         asp-append-version="true" />
                </div>
                
                <div class="col-md-7 col-lg-8 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <h1 class="h3 fw-bold text-white mb-0">
                                @Html.DisplayFor(model => Model.Film.FilmName)
                            </h1>
                            <span class="badge bg-warning text-dark fs-6 fw-bold px-3 py-2 shadow-sm">
                                ★ @Html.DisplayFor(model => Model.Film.Rating) / 10
                            </span>
                        </div>

                        <div class="mb-3">
                            <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary border-opacity-25 px-2 py-1">
                                🎭 @Html.DisplayFor(model => Model.Film.Genre)
                            </span>
                        </div>

                        <h5 class="text-white-50 fs-6 fw-semibold text-uppercase tracking-wider mt-4 mb-2">Опис</h5>
                        <p class="text-secondary" style="line-height: 1.7; font-size: 0.95rem;">
                            @Html.DisplayFor(model => Model.Film.Description)
                        </p>
                    </div>
                    
                    <div class="d-flex gap-2 pt-3 mt-4 border-top border-secondary border-opacity-25">
                        <a asp-page="/Edit" asp-route-id="@Model.Film.Id" class="btn btn-warning px-4 fw-semibold">
                            ✏️ Редагувати
                        </a>
                        <a asp-page="/Delete" asp-route-id="@Model.Film.Id" class="btn btn-outline-danger px-4">
                            🗑️ Видалити
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>